# Docker Compose uses this file after you copy it to .env.docker.
# Use URL-safe values for POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB
# because they are assembled into DATABASE_URL by Docker Compose.
POSTGRES_DB=task_deconstructor
POSTGRES_USER=task_deconstructor
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Generate a long, random value. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# External provider credentials are used only by the backend container.
GEMINI_API_KEY=your_gemini_api_key
HF_API_KEY=your_hugging_face_token

# Browser-facing URL for the local Compose frontend.
CLIENT_ORIGIN=http://localhost:8080
TRUST_PROXY=true

# Optional backend settings
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
AUTH_COOKIE_NAME=task_deconstructor_session
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT=20kb
